# =============================================================================
# Financial Slides Agent — Datadog + LangSmith Distributed Tracing
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LangSmith Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://smith.langchain.com/settings

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=financial-slides-agent

# LangSmith IDs for constructing trace URLs
# To get these:
#   1. Run: langgraph dev
#   2. Open LangGraph Studio and run the agent once
#   3. Click on the trace in LangSmith
#   4. Copy the IDs from the URL: smith.langchain.com/o/{WORKSPACE_ID}/projects/p/{PROJECT_ID}/r/...
LS_WORKSPACE_ID=your-workspace-uuid
LS_PROJECT_ID=your-project-uuid

# -----------------------------------------------------------------------------
# Anthropic API Key (for Claude — powers the agent)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OpenAI API Key (for GPT-4.1 — powers the LLM judge evaluators)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Datadog APM Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys

DD_API_KEY=your-datadog-api-key-here

# Service name shown in Datadog APM
DD_SERVICE=langsmith-ddog-distributed-tracing-demo

# Environment tag (dev, staging, prod)
DD_ENV=dev

# IMPORTANT: Set this to match YOUR Datadog region!
# Check your Datadog URL to find the correct value:
#   - app.datadoghq.com      → DD_SITE=datadoghq.com
#   - app.us5.datadoghq.com  → DD_SITE=us5.datadoghq.com
#   - app.datadoghq.eu       → DD_SITE=datadoghq.eu
DD_SITE=us5.datadoghq.com

# -----------------------------------------------------------------------------
# Datadog Agent Configuration
# -----------------------------------------------------------------------------
# You MUST run the Datadog Agent locally via Docker:
#
#   docker run -d --name dd-agent \
#     -e DD_API_KEY=<your-api-key> \
#     -e DD_APM_ENABLED=true \
#     -e DD_APM_NON_LOCAL_TRAFFIC=true \
#     -e DD_SITE=<your-site>.datadoghq.com \
#     -e DD_HOSTNAME=langsmith-demo-local \
#     -p 8126:8126 \
#     gcr.io/datadoghq/agent:latest
#
# The DD_HOSTNAME is required to prevent "unable to determine hostname" errors.
# The agent listens on localhost:8126 by default.

# -----------------------------------------------------------------------------
# Datadog RUM Configuration (Frontend)
# -----------------------------------------------------------------------------
# Create a RUM application at: https://app.datadoghq.com/rum/application/create
# 1. Click "New Application"
# 2. Select "JS" (JavaScript)
# 3. Choose "Manual Instrumentation" → "CDN async"
# 4. Copy the applicationId and clientToken values

DD_RUM_APPLICATION_ID=your-rum-application-id
DD_RUM_CLIENT_TOKEN=pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RUM will use DD_SERVICE, DD_ENV, and DD_SITE from above

# -----------------------------------------------------------------------------
# Datadog LLM Observability
# -----------------------------------------------------------------------------
# Enables the LLM Observability product — shows prompts, completions,
# token usage, and model info under LLM Observability in Datadog.
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=langsmith-ddog-distributed-tracing-demo
DD_LLMOBS_AGENTLESS_ENABLED=0
